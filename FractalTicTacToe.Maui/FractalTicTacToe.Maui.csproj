<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0-android;net8.0-ios</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>FractalTicTacToe.Maui</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>disable</Nullable>

		<!-- Nombre comercial e identificador para Google Play Store y Apple App Store -->
		<ApplicationTitle>Gatote Fractal</ApplicationTitle>
		<ApplicationId>com.anahuac.gatotefractal</ApplicationId>

		<!-- Versiones -->
		<ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">11.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<AndroidManifest>Platforms\Android\AndroidManifest.xml</AndroidManifest>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<AndroidPackageFormat>aab</AndroidPackageFormat>
		<AndroidKeyStore Condition="Exists('gatote-release.keystore')">true</AndroidKeyStore>
		<AndroidSigningKeyStore Condition="Exists('gatote-release.keystore')">gatote-release.keystore</AndroidSigningKeyStore>
		<AndroidSigningKeyAlias Condition="Exists('gatote-release.keystore')">gatote_key</AndroidSigningKeyAlias>
	</PropertyGroup>

	<ItemGroup>
		<EmbeddedResource Include="Assets\gatote_logo.png" />
		<EmbeddedResource Include="Assets\gatote_icon.png" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\FractalTicTacToe.Core\FractalTicTacToe.Core.csproj" />
	</ItemGroup>

</Project>
