<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FractalTicTacToe.Core\FractalTicTacToe.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Libera automáticamente cualquier instancia previa del servidor en Windows antes de compilar para evitar bloqueos MSB3026 -->
  <Target Name="StopRunningServerInstance" BeforeTargets="BeforeBuild;CopyFilesToOutputDirectory" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="powershell -NoProfile -Command &quot;Get-Process -Name 'FractalTicTacToe.Server' -ErrorAction SilentlyContinue | Stop-Process -Force; Get-CimInstance Win32_Process -Filter \&quot;Name = 'dotnet.exe' AND CommandLine LIKE '%FractalTicTacToe.Server.dll%'\&quot; -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue }&quot;" IgnoreExitCode="true" />
  </Target>

</Project>
